<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Canonical host for the live store. Apex and plain HTTP on that host
    # go to https://www.urbanfocus.co.za. X-Forwarded-Proto is checked so
    # Cloudflare Flexible SSL does not bounce forever. Other hosts (local,
    # staging) are left alone.
    RewriteCond %{HTTP_HOST} ^urbanfocus\.co\.za$ [NC]
    RewriteRule ^ https://www.urbanfocus.co.za%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^www\.urbanfocus\.co\.za$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://www.urbanfocus.co.za%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Serve crawler files from Laravel even if leftover static copies exist in public_html.
    RewriteRule ^(robots\.txt|llms\.txt|BingSiteAuth\.xml|sitemap(-[a-z]+)?\.xml)$ index.php [L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# PHP sets these on HTML responses. Repeat them only for static files so
# Apache and PHP do not send the same header twice on every page.
<IfModule mod_headers.c>
    Header unset X-Powered-By
    <FilesMatch "\.(css|js|mjs|jpg|jpeg|png|gif|webp|svg|ico|woff2?|ttf|eot|map)$">
        Header set X-Content-Type-Options "nosniff"
        Header set X-Frame-Options "SAMEORIGIN"
        Header set Referrer-Policy "strict-origin-when-cross-origin"
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
