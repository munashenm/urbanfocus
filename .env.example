APP_NAME="Urban Focus"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Johannesburg
APP_URL=https://www.urbanfocus.co.za

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=urbanfocus_db
DB_USERNAME=urbanfocus_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=urbanfocus_

MAIL_MAILER=smtp
MAIL_HOST=mail.urbanfocus.co.za
MAIL_PORT=587
MAIL_USERNAME=sales@urbanfocus.co.za
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=sales@urbanfocus.co.za
MAIL_FROM_NAME="Urban Focus"

# Business contact
BUSINESS_PHONE="087 550 1813"
BUSINESS_EMAIL=sales@urbanfocus.co.za
BUSINESS_ADDRESS="South Africa"

# PayFast (sandbox: https://sandbox.payfast.co.za)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
PAYFAST_RETURN_URL="${APP_URL}/checkout/payfast/return"
PAYFAST_CANCEL_URL="${APP_URL}/checkout/payfast/cancel"
PAYFAST_NOTIFY_URL="${APP_URL}/checkout/payfast/notify"

# Shipping
SHIPPING_FLAT_RATE=99.00
SHIPPING_FREE_THRESHOLD=1500.00
SHIPPING_MANUAL_QUOTE_ENABLED=true

# VAT (South Africa)
VAT_RATE=15

# Google / SEO
GOOGLE_SITE_VERIFICATION=
