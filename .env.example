APP_NAME="Urban Focus"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Johannesburg
APP_URL=https://www.urbanfocus.co.za

# cPanel Plan B: full path to public_html when Laravel lives outside it
# Example: /home/urbanzdc/public_html
PUBLIC_PATH=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_cpanel_database_name
DB_USERNAME=your_cpanel_database_user
DB_PASSWORD=your_database_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=urbanfocus_

MAIL_MAILER=smtp
MAIL_HOST=mail.urbanfocus.co.za
MAIL_PORT=587
MAIL_USERNAME=sales@urbanfocus.co.za
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=sales@urbanfocus.co.za
MAIL_FROM_NAME="Urban Focus"

# Business contact
BUSINESS_PHONE="087 550 1813"
BUSINESS_PHONE_TEL=0875501813
BUSINESS_EMAIL=sales@urbanfocus.co.za
BUSINESS_ADDRESS_LINE1="17 Waterloo RD"
BUSINESS_ADDRESS_LINE2="Samrand Business Park"
BUSINESS_CITY=Centurion
BUSINESS_PROVINCE=Gauteng
BUSINESS_HOURS="Mon–Fri 8:00–17:00"
CAREERS_EMAIL=sales@urbanfocus.co.za
BUSINESS_VAT_NUMBER=
BUSINESS_COMPANY_REG=

# Inventory alerts
LOW_STOCK_THRESHOLD=5
LOW_STOCK_ALERT_EMAIL=sales@urbanfocus.co.za

# Social profile URLs (footer & schema)
SOCIAL_FACEBOOK=https://www.facebook.com/urbanfocusonline
SOCIAL_INSTAGRAM=https://www.instagram.com/urbanfocusonline/
SOCIAL_X=https://x.com/urbanfocusza
SOCIAL_TIKTOK=https://www.tiktok.com/@urbanfocussa

# Social auto-posting (requires API keys — Admin → Social Media for setup)
SOCIAL_POSTING_ENABLED=false
SOCIAL_POST_FACEBOOK=true
SOCIAL_POST_INSTAGRAM=true
SOCIAL_POST_X=true
SOCIAL_POST_TIKTOK=false
SOCIAL_POST_MAX_PER_RUN=5
SOCIAL_HASHTAGS="#UrbanFocus #ITSouthAfrica #Tech"

# Meta (Facebook Page + Instagram Business)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=

# X (Twitter) API — use OAuth 1.0a keys for posting (recommended)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Or OAuth 2.0 user access token with tweet.write (NOT the app-only bearer token)
X_BEARER_TOKEN=

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_ACCESS_TOKEN=

# PayFast (sandbox: https://sandbox.payfast.co.za)
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase
PAYFAST_SANDBOX=true
PAYFAST_RETURN_URL="${APP_URL}/checkout/payfast/return"
PAYFAST_CANCEL_URL="${APP_URL}/checkout/payfast/cancel"
PAYFAST_NOTIFY_URL="${APP_URL}/checkout/payfast/notify"

# Shipping
SHIPPING_FLAT_RATE=99.00
SHIPPING_FREE_THRESHOLD=1500.00
SHIPPING_MANUAL_QUOTE_ENABLED=true

# VAT (South Africa)
VAT_RATE=15

# Retail pricing (applied on CSV import and apply-markup.php)
PRICE_MARKUP_PERCENT=40
PRICE_ROUND_TO=100
PRICE_ROUND_MODE=up

# EFT bank details (shown on checkout success page and order emails)
EFT_BANK_NAME=
EFT_ACCOUNT_NAME="Urban Focus"
EFT_ACCOUNT_NUMBER=
EFT_BRANCH_CODE=
EFT_ACCOUNT_TYPE=Current

# Google / SEO
GOOGLE_SITE_VERIFICATION=

# Blog news sync (optional NewsAPI — free RSS works without a key)
NEWSAPI_ENABLED=false
NEWSAPI_KEY=
NEWSAPI_QUERY="technology OR cybersecurity OR networking"
NEWS_MAX_PER_FEED=3
NEWS_PUBLISH_AS_DRAFT=true

# Google Reviews (optional — homepage trust section)
GOOGLE_REVIEWS_ENABLED=false
GOOGLE_PLACE_ID=
GOOGLE_RATING=4.8
GOOGLE_REVIEW_COUNT=50
GOOGLE_REVIEWS_URL=https://g.page/r/urbanfocus/review

# Products API (optional — or generate in Admin → Catalog & Feeds)
API_KEY=
